msgid "Time Series Plot"
msgstr "نمودار سری زمانی"

msgid "Lag Plot"
msgstr "نمودار تأخیر"

msgid "The specified lag, %1$s, is too large given the %2$s observations in the data. Please choose a smaller lag."
msgstr ""
"تأخیر مشخص‌شده، %1$s، با توجه به %2$s مشاهده در داده‌ها بسیار بزرگ است. لطفاً "
"تأخیر کوچک‌تری را انتخاب کنید."

msgid "Autocorrelation Function"
msgstr "تابع خودهمبستگی"

msgid "Partial Autocorrelation Function"
msgstr "تابع خودهمبستگی جزئی"

msgid "Descriptive Statistics"
msgstr "آمار توصیفی"

msgid "Valid"
msgstr "معتبر"

msgid "Missing"
msgstr "گم‌شده"

msgid "Mean"
msgstr "میانگین"

msgid "Std. Deviation"
msgstr "انحراف معیار"

msgid "Variance"
msgstr "واریانس"

msgid "Range"
msgstr "دامنه"

msgid "Minimum"
msgstr "حداقل"

msgid "Maximum"
msgstr "حداکثر"

msgid "Start"
msgstr "شروع"

msgid "End"
msgstr "پایان"

msgid "Lag 1 Autocorrelation"
msgstr "خودهمبستگی تأخیر ۱"

msgid "The time series data should be equally-spaced."
msgstr "داده‌های سری زمانی باید با فواصل مساوی باشند."

msgid "The time variable should have unique values only."
msgstr "متغیر زمان باید فقط دارای مقادیر یکتا باشد."

msgid "The 'Time' variable has a date-like format, please filter by date instead."
msgstr ""
"متغیر «زمان» قالبی شبیه به تاریخ دارد، لطفاً به جای آن بر اساس تاریخ فیلتر "
"کنید."

msgid "The 'Time' variable is not in a date-like format (e.g., yyyy-mm-dd hh:mm:ss). Try to filter by time index instead."
msgstr ""
"متغیر «زمان» در قالبی شبیه به تاریخ (مثلاً yyyy-mm-dd hh:mm:ss) نیست. سعی کنید "
"به جای آن بر اساس نمایه زمان فیلتر کنید."

msgid "'Start' must be in a date-like format (e.g., yyyy-mm-dd hh:mm:ss)."
msgstr "«شروع» باید در قالبی شبیه به تاریخ (مثلاً yyyy-mm-dd hh:mm:ss) باشد."

msgid "The 'Start' value of the filter should be before last observation."
msgstr "مقدار «شروع» فیلتر باید قبل از آخرین مشاهده باشد."

msgid "'End' must be in a date-like format (e.g., yyyy-mm-dd hh:mm:ss)."
msgstr "«پایان» باید در قالبی شبیه به تاریخ (مثلاً yyyy-mm-dd hh:mm:ss) باشد."

msgid "The 'End' value of the filter should be larger/later than the 'Start' value."
msgstr "مقدار «پایان» فیلتر باید بزرگ‌تر/دیرتر از مقدار «شروع» باشد."

msgid "Lag"
msgstr "تأخیر"

msgid "Association %s"
msgstr "پیوند %s"

msgid "Frequency Tables"
msgstr "جدول‌های فراوانی"

msgid "Correlation plots"
msgstr "نمودارهای همبستگی"

msgid "Correlation plot"
msgstr "نمودار همبستگی"

msgid "Distribution Plots"
msgstr "نمودارهای توزیع"

msgid "Boxplots"
msgstr "نمودارهای جعبه‌ای"

msgid "Q-Q Plots"
msgstr "نمودارهای Q-Q"

msgid "Q-Q Plot"
msgstr "نمودار Q-Q"

msgid "Plotting is not possible: Variable only contains NA!"
msgstr "رسم نمودار امکان‌پذیر نیست: متغیر فقط حاوی NA است!"

msgid "Pie charts"
msgstr "نمودارهای دایره‌ای"

msgid "Stem and Leaf"
msgstr "ساقه و برگ"

msgid "Scatter Plots"
msgstr "نمودارهای پراکنش"

msgid "Interval plots"
msgstr "نمودارهای بازه‌ای"

msgid "Dot Plots"
msgstr "نمودارهای نقطه‌ای"

msgid "Heatmaps"
msgstr "نقشه‌های حرارتی"

msgid "Pareto Plots"
msgstr "نمودارهای پارتو"

msgid "Frequency Plots"
msgstr "نمودارهای فراوانی"

msgid "Likert Plots"
msgstr "نمودارهای لیکرت"

msgid "Excluded %1$i rows from the analysis that correspond to the missing values of the split-by variable %2$s"
msgstr ""
"%1$i ردیف از تحلیل که مربوط به مقادیر گم‌شده متغیر تفکیک‌کننده %2$s بودند، حذف "
"شدند."

msgid "%s%% Confidence Interval Mean"
msgstr "میانگین بازه اطمینان %s%%"

msgid "%s%% Confidence Interval Std. Dev."
msgstr "انحراف معیار بازه اطمینان %s%%"

msgid "%s%% Confidence Interval Variance"
msgstr "واریانس بازه اطمینان %s%%"

msgid "Upper"
msgstr "بالا"

msgid "Lower"
msgstr "پایین"

msgid "%s%% CI A. Mean Upper"
msgstr "کران بالای میانگین حسابی بازه اطمینان %s%%"

msgid "%s%% CI A. Mean Lower"
msgstr "کران پایین میانگین حسابی بازه اطمینان %s%%"

msgid "%s%% CI Std. Dev. Upper"
msgstr "کران بالای انحراف معیار بازه اطمینان %s%%"

msgid "%s%% CI Std. Dev. Lower"
msgstr "کران پایین انحراف معیار بازه اطمینان %s%%"

msgid "%s%% CI Variance Upper"
msgstr "کران بالای واریانس بازه اطمینان %s%%"

msgid "%s%% CI Variance Lower"
msgstr "کران پایین واریانس بازه اطمینان %s%%"

msgid "Mode"
msgstr "مُد"

msgid "Median"
msgstr "میانه"

msgid "Mean (arithmetic)"
msgstr "میانگین (حسابی)"

msgid "Std. Error of A. Mean"
msgstr "خطای معیار میانگین حسابی"

msgid "Mean (geometric)"
msgstr "میانگین (هندسی)"

msgid "Mean (harmonic)"
msgstr "میانگین (همساز)"

msgid "Coefficient of variation"
msgstr "ضریب تغییرات"

msgid "MAD"
msgstr "انحراف مطلق از میانه (MAD)"

msgid "MAD robust"
msgstr "انحراف مطلق از میانه مقاوم"

msgid "IQR"
msgstr "دامنه میان‌چارکی (IQR)"

msgid "Skewness"
msgstr "چولگی"

msgid "Std. Error of Skewness"
msgstr "خطای معیار چولگی"

msgid "Kurtosis"
msgstr "کشیدگی"

msgid "Std. Error of Kurtosis"
msgstr "خطای معیار کشیدگی"

msgid "Shapiro-Wilk"
msgstr "شاپیرو-ویلک"

msgid "P-value of Shapiro-Wilk"
msgstr "مقدار P شاپیرو-ویلک"

msgid "25th percentile"
msgstr "صدک ۲۵ام"

msgid "50th percentile"
msgstr "صدک ۵۰ام"

msgid "75th percentile"
msgstr "صدک ۷۵ام"

msgid "%gth percentile"
msgstr "صدک %gام"

msgid "Error in Percentiles, all values should >=0 and <=100"
msgstr "خطا در صدک‌ها، همه مقادیر باید >=۰ و <=۱۰۰ باشند."

msgid "Sum"
msgstr "مجموع"

msgid "All values are identical"
msgstr "همه مقادیر یکسان هستند."

msgid "Infimum (minimum) of an empty set is %1$s, supremum (maximum) of an empty set is %2$s."
msgstr ""
"اینفیمم (حداقل) یک مجموعه تهی %1$s و سوپریمم (حداکثر) یک مجموعه تهی %2$s است."

msgid "More than one mode exists. For nominal and ordinal data, the first mode is reported. For continuous data, the mode with the highest density estimate is reported but multiple modes may exist. We recommend visualizing the data to check for multimodality."
msgstr ""
"بیش از یک مُد وجود دارد. برای داده‌های اسمی و ترتیبی، اولین مُد گزارش می‌شود. "
"برای داده‌های پیوسته، مودی با بالاترین برآورد چگالی گزارش می‌شود، اما ممکن است "
"چندین مُد وجود داشته باشد. ما توصیه می‌کنیم داده‌ها را مصورسازی کنید تا چندمُدی "
"بودن را بررسی نمایید."

msgid "Geometric and harmonic means are defined only for strictly positive variables, but the data contain some non-positive values."
msgstr ""
"میانگین‌های هندسی و همساز فقط برای متغیرهای اکیداً مثبت تعریف می‌شوند، اما "
"داده‌ها حاوی برخی مقادیر غیرمثبت هستند."

msgid "For ordinal variables, quantile type 3 was used because the selected type is not supported."
msgstr ""
"برای متغیرهای ترتیبی، از نوع چندک ۳ استفاده شد، زیرا نوع انتخاب‌شده پشتیبانی "
"نمی‌شود."

msgid "Total"
msgstr "کل"

msgid "All variables have more than %1$s distinct values"
msgstr "همه متغیرها بیش از %1$s مقدار متمایز دارند."

msgid "Frequencies"
msgstr "فراوانی‌ها"

msgid "Frequencies for %s"
msgstr "فراوانی‌های %s"

msgid "Frequency"
msgstr "فراوانی"

msgid "Percent"
msgstr "درصد"

msgid "Valid Percent"
msgstr "درصد معتبر"

msgid "Cumulative Percent"
msgstr "درصد تجمعی"

msgid "Plotting not possible: %s"
msgstr "رسم نمودار امکان‌پذیر نیست: %s"

msgid "Plotting is not possible: No plot type selected!"
msgstr "رسم نمودار امکان‌پذیر نیست: هیچ نوع نموداری انتخاب نشده است!"

msgid "Counts"
msgstr "شمارش‌ها"

msgid "Density"
msgstr "چگالی"

msgid "No non-missing values!"
msgstr "هیچ مقدار غیر گم‌شده‌ای وجود ندارد!"

msgid "Association cannot be computed due to missing values. Try a different 'Use' setting."
msgstr ""
"به دلیل مقادیر گم‌شده، محاسبه پیوند امکان‌پذیر نیست. تنظیم «روش مدیریت» "
"متفاوتی را امتحان کنید."

msgid "Some associations cannot be computed due to missing values. Try a different 'Use' setting."
msgstr ""
"برخی پیوندها به دلیل مقادیر گم‌شده قابل محاسبه نیستند. تنظیم «روش مدیریت» "
"متفاوتی را امتحان کنید."

msgid "Plotting not possible: Variable '%s' has fewer than 2 valid (non-missing) observations."
msgstr ""
"رسم نمودار امکان‌پذیر نیست: متغیر «%s» کمتر از ۲ مشاهده معتبر (غیر گم‌شده) "
"دارد."

msgid "Stem"
msgstr "ساقه"

msgid "Leaf"
msgstr "برگ"

msgid "A stem and leaf table could not be made because there are fewer than 2 non-missing observations"
msgstr ""
"به دلیل وجود کمتر از ۲ مشاهده غیر گم‌شده، ساخت جدول ساقه و برگ امکان‌پذیر نبود."

msgid "The decimal point is at the |"
msgstr "نقطه اعشار در | قرار دارد."

msgid "There must be a unique value per combination of levels of horizontal and vertical axis!"
msgstr ""
"باید به ازای هر ترکیب از سطوح محور افقی و عمودی، یک مقدار یکتا وجود داشته "
"باشد!"

msgid "All categorical variables must have the same number of levels!"
msgstr "همه متغیرهای مقوله‌ای باید تعداد سطوح یکسانی داشته باشند!"

msgid "Items must have 2 or more levels!"
msgstr "اقلام باید دارای ۲ سطح یا بیشتر باشند!"

msgid "The variable used for counts must be different from the variable used for categories."
msgstr ""
"متغیر استفاده‌شده برای شمارش‌ها باید با متغیر استفاده‌شده برای دسته‌ها متفاوت "
"باشد."

msgid "Percentage (%%)"
msgstr "درصد (%%)"

msgid "Levels within variable require at least two or more data points!"
msgstr "سطوح درون متغیر نیازمند حداقل دو نقطه داده یا بیشتر هستند!"

msgid "Please assign a variable to every RM factor (defined in Repeated Measures Factors) within Repeated Measures Cells."
msgstr ""
"لطفاً برای هر عامل اندازه‌گیری مکرر (تعریف‌شده در عامل‌های اندازه‌گیری مکرر) درون "
"سلول‌های اندازه‌گیری مکرر، یک متغیر اختصاص دهید."

msgid "Plots"
msgstr "نمودارها"

msgid "Available Plot IDs"
msgstr "شناسه‌های نمودار موجود"

msgid "Plot Grid"
msgstr "شبکه نمودار"

msgid "Raincloud Plots"
msgstr "نمودارهای ابر بارانی"

msgid "Not shown are %s observations due to missing data."
msgstr "%s مشاهده به دلیل داده‌های گم‌شده نمایش داده نمی‌شوند."

msgid "Interval around mean is custom."
msgstr "بازه حول میانگین سفارشی است."

msgid "<span style = 'color: darkorange'>Error with custom interval: Specified number of clouds does not match clouds in plot.</span>"
msgstr ""
"<span style = 'color: darkorange'>خطا در بازه سفارشی: تعداد مشخص‌شده ابرها با "
"ابرهای موجود در نمودار مطابقت ندارد.</span>"

msgid "Interval around mean represents ± 1 standard error"
msgstr "بازه حول میانگین نشان‌دهنده ± ۱ خطای معیار است."

msgid "Interval around mean represents ± 1 standard deviation"
msgstr "بازه حول میانگین نشان‌دهنده ± ۱ انحراف معیار است."

msgid "Interval around mean represents %d%% confidence interval."
msgstr "بازه حول میانگین نشان‌دهنده بازه اطمینان %d%% است."

msgid "Points are slightly jittered from their true values."
msgstr "نقاط کمی از مقادیر واقعی خود لرزش دارند."

msgid "<span style = 'color: darkorange'> Warning! Some data is not shown<br>because it lies outside of the interval set by the custom axis limits.</span>"
msgstr ""
"<span style = 'color: darkorange'> هشدار! برخی داده‌ها نمایش داده نمی‌شوند<br>"
"زیرا خارج از بازه تعیین‌شده توسط حدود سفارشی محور قرار دارند.</span>"

msgid "<span style = 'color: darkorange'> Error with custom orientation: Specified number of clouds does not match clouds in plot.<br>Reverted to default all 'R'. Point nudge set to 0.</span>"
msgstr ""
"<span style = 'color: darkorange'> خطا در جهت‌گیری سفارشی: تعداد مشخص‌شده "
"ابرها با ابرهای موجود در نمودار مطابقت ندارد.<br>به حالت پیش‌فرض همه 'R' "
"بازگشت. جابه‌جایی نقطه روی ۰ تنظیم شد.</span>"

msgid "<span style = 'color: darkorange'> Error with custom color: Specified number of clouds does not match clouds in plot.<br>Ignoring custom color input.</span>"
msgstr ""
"<span style = 'color: darkorange'> خطا در رنگ سفارشی: تعداد مشخص‌شده ابرها با "
"ابرهای موجود در نمودار مطابقت ندارد.<br>ورودی رنگ سفارشی نادیده گرفته "
"می‌شود.</span>"

msgid "Statistics"
msgstr "آماره‌ها"

msgid "Primary Factor"
msgstr "عامل اصلی"

msgid "Secondary Factor"
msgstr "عامل ثانویه"

msgid "<i>N</i>"
msgstr "<i>N</i>"

msgid "Lower Whisker"
msgstr "سبیل پایین"

msgid "25th Percentile"
msgstr "صدک ۲۵ام"

msgid "75th Percentile"
msgstr "صدک ۷۵ام"

msgid "Upper Whisker"
msgstr "سبیل بالا"

msgid "%s%% CI for Mean Difference"
msgstr "بازه اطمینان %s%% برای تفاوت میانگین"

msgid "Standard Error"
msgstr "خطای معیار"

msgid "Standard Deviation"
msgstr "انحراف معیار"

msgid "<i>N</i><sub>Total</sub> = %s."
msgstr "<i>N</i><sub>کل</sub> = %s."

msgid "This excludes %s observations due to missing data."
msgstr "این مورد %s مشاهده را به دلیل داده‌های گم‌شده حذف می‌کند."

msgid "<br>Interval around mean is custom."
msgstr "<br>بازه حول میانگین سفارشی است."

msgid "<br>Interval around mean represents %d%% confidence interval."
msgstr "<br>بازه حول میانگین نشان‌دهنده بازه اطمینان %d%% است."

msgid "%2$s has more than %1$s distinct values and is omitted."
msgid_plural "The following variables have more than %1$s distinct values and are omitted: %2$s."
msgstr[0] "متغیرهای زیر بیش از %1$s مقدار متمایز دارند و حذف می‌شوند: %2$s."
msgstr[1] "متغیرهای زیر بیش از %1$s مقدار متمایز دارند و حذف می‌شوند: %2$s."

msgid "The decimal point is %s digit to the right of the |"
msgid_plural "The decimal point is %s digits to the right of the |"
msgstr[0] "نقطه اعشار %s رقم به سمت راست | قرار دارد."
msgstr[1] "نقطه اعشار %s رقم به سمت راست | قرار دارد."

msgid "The decimal point is %s digit to the left of the |"
msgid_plural "The decimal point is %s digits to the left of the |"
msgstr[0] "نقطه اعشار %s رقم به سمت چپ | قرار دارد."
msgstr[1] "نقطه اعشار %s رقم به سمت چپ | قرار دارد."
