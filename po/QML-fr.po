msgstr "ID"

msgctxt "raincloudPlots|"
msgid ""
"Select a participant/observation ID in your dataset, to connect individual "
"observations (points) accross the levels of the primary factor. Otherwise, "
"you do not need this."
msgstr ""
"Sélectionnez un ID de participant/observation dans votre ensemble de données "
"pour relier les observations individuelles (points) entre les niveaux du "
"facteur principal. Sinon, vous n'avez pas besoin de cette option."

msgctxt "raincloudPlots|"
msgid "General"
msgstr "Général"

msgctxt "raincloudPlots|"
msgid "Color palette"
msgstr "Palette de couleurs"

msgctxt "raincloudPlots|"
